data_CLASH_SYM
#
# Small unit cell: two Base atoms that do NOT clash within the asymmetric unit
# (dist 7.5 A) but DO clash across the periodic boundary (dist 2.5 A). Used to
# check that --symmetry / symmetry=True is required to find the contact.
#
_cell.length_a    10.0
_cell.length_b    10.0
_cell.length_c    10.0
_cell.angle_alpha 90.0
_cell.angle_beta  90.0
_cell.angle_gamma 90.0
_symmetry.space_group_name_H-M 'P 1'
