data_CLASHING_STATES
#
# Synthetic structure for clash-detection tests. Atoms are grouped into spatially
# separated clusters (~50 A apart in x) so each scenario is isolated:
#   res 1/5   : binary x binary -> merge A+D, B+C   (A@res1 clashes C@res5)
#   res 10/12 : res10 has 3 alts (E,F,G) -> NOT rule (E@res10 clashes H@res12)
#   res 20/25 : benign; res20 has CB in both K and L, so K@res20 vs L@res25 is an alternative
#   res 30/31 : Base O clashes state M -> ancestor warning
#   res 40/41 : two Base atoms clash -> same-state warning
#   res 50/51 : Base C-N at 1.33 A -> covalent bond, excluded
#   res 60/61 : Base S-S at 2.05 A -> disulfide, excluded
#
_cell.length_a    500.0
_cell.length_b    500.0
_cell.length_c    500.0
_cell.angle_alpha 90.0
_cell.angle_beta  90.0
_cell.angle_gamma 90.0
_symmetry.space_group_name_H-M 'P 1'
